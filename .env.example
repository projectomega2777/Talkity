# Talkity backend environment configuration
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. Never place real
# credentials in source control or in client-side files.

# HTTP port for the standalone Express server (default: 3000)
PORT=3000

# AI provider API keys — server-side only, never exposed to clients.
# Groq (Whisper transcription + LLM polish): https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI (Whisper transcription + LLM polish): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Deployment API token — B1 authentication. Shared by all clients (web, browser
# extension, desktop). Must be set in production; the server refuses all API
# requests otherwise when NODE_ENV=production. Same value must be entered in
# the clients' settings (never committed, never embedded in shipped JS).
TALKITY_API_TOKEN=

# Set only for production-style deployments (e.g. NODE_ENV=production)
# NODE_ENV=production
